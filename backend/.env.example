# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
AUTH_TOKEN_TTL_HOURS=12
# Keep 0 unless requests pass through a known, fixed number of trusted proxies.
DRF_NUM_PROXIES=0
# Set to 1 only when Django is reachable exclusively through a trusted proxy
# that overwrites X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=0

MYSQL_DATABASE=algo_trading
MYSQL_USER=algo_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
# Must match whatever host port docker-compose.yml maps MySQL to.
# docker-compose.yml's own default is "3307:3306" (host:container) --
# deliberately NOT 3306, to avoid clashing with a MySQL already
# running locally on the standard port. 3307 here matches that
# default; only change this if you also changed the mapping in
# docker-compose.yml.
MYSQL_PORT=3307

REDIS_URL=redis://127.0.0.1:6379/0
# Dedicated shared Django cache/throttle database; do not reuse Channels/Celery keys.
CACHE_REDIS_URL=redis://127.0.0.1:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Broker + news integrations (manual section 4).
#
# BROKER_MODE controls the market-data source only. "live" permits Angel One
# data/session calls; it does not by itself authorize real order placement.
BROKER_MODE=paper

# EXECUTION_MODE seeds the database-backed execution mode on a fresh install.
# Keep paper for simulation. Real orders additionally require the persisted
# mode to be live and the deployment-owned LIVE_TRADING_ENABLED gate below.
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=0

# Paper fills use static, adverse per-side assumptions because candle history
# has no trustworthy order-book spread. Values are snapshotted per position.
PAPER_CASH_SLIPPAGE_BPS_PER_SIDE=5.0
PAPER_CASH_FEES_BPS_PER_SIDE=5.0
PAPER_OPTION_SLIPPAGE_BPS_PER_SIDE=25.0
PAPER_OPTION_FEES_BPS_PER_SIDE=10.0

# Approved signals older than this are rejected before execution.
MAX_SIGNAL_AGE_MINUTES=10

# apps.paper_trading -- the autonomous AI paper-trading subsystem. A
# fully separate vertical from EXECUTION_MODE/PAPER_* above -- see that
# app's own module docs. TRADING_MODE/ORDER_EXECUTION_PROVIDER must stay
# "paper" (the app raises RuntimeError at startup otherwise); live order
# routing is not implemented in this codebase.
TRADING_MODE=paper
MARKET_DATA_PROVIDER=angelone
ORDER_EXECUTION_PROVIDER=paper
# Second, independent gate (ANDed with LIVE_TRADING_ENABLED) inside
# apps.market_data.broker_client.BrokerClient.place_order -- keep false.
ALLOW_LIVE_ORDERS=false
INITIAL_PAPER_CAPITAL=100000

# One-lot / one-position / no-averaging hard rules -- the AI's decision
# policy may never override these (apps.paper_trading.services.
# paper_risk_engine enforces them independently of what any model says).
LOTS_PER_TRADE=1
MAX_CONCURRENT_POSITIONS=1
MAX_TRADES_PER_DAY=0
ALLOW_REENTRY=true
ALLOW_AVERAGING=false
ALLOW_PYRAMIDING=false
ALLOW_MARTINGALE=false
ALLOW_OPTION_SELLING=false

AI_PAPER_DAILY_LOSS_LIMIT_PCT=3.0
AI_PAPER_MAX_DRAWDOWN_PCT=15.0
AI_PAPER_MAX_CONSECUTIVE_LOSSES=3
AI_PAPER_COOLDOWN_MINUTES=30
AI_PAPER_SLIPPAGE_BPS=5
AI_PAPER_SPREAD_FALLBACK_BPS=20
AI_PAPER_EXECUTION_LATENCY_MS=250
AI_PAPER_FILL_MODEL_VERSION=v1
AI_PAPER_STALE_QUOTE_SECONDS=120

# Shares Angel One rate-limit/cooldown state across every Celery worker
# process via the Redis-backed cache above -- keep this on ("1") in any
# real multi-worker deployment; "0" is only for tests, which set it
# automatically and must never wait on Redis-backed timing windows.
SMARTAPI_DISTRIBUTED_RATE_LIMIT=1

# apps.options.subscription_manager / apps.market_data.broker_ws_client --
# bounds the live option WebSocket subscription to ATM +/- this many
# strikes (both CE and PE) on the resolved/selected expiry only, instead
# of every synced expiry's every strike. See subscription_manager's own
# module docstring for the dropped-tick incident this fixes.
OPTIONS_LIVE_STRIKE_RANGE=20
OPTIONS_LIVE_MAX_TOKENS_PER_SUBSCRIBE=50
OPTIONS_LIVE_SUBSCRIPTION_REFRESH_SECONDS=15
OPTIONS_LIVE_TICK_WORKERS=4
LIVE_INDEX_TICK_WORKERS=2
OPTIONS_LIVE_HEARTBEAT_SECONDS=10
OPTIONS_LIVE_STATS_PUBLISH_INTERVAL_SECONDS=2

# apps.monitoring.health.SystemHealthView staleness thresholds.
LIVE_FEED_STALE_SECONDS=45
CELERY_HEARTBEAT_STALE_SECONDS=150

# Console log level. Never set DEBUG here in production -- the redaction
# filter (common/log_filters.py) still applies at every level, but DEBUG
# output from third-party libraries is inherently more likely to include
# raw request/response bodies.
DJANGO_LOG_LEVEL=INFO

# ANGEL_ONE_TOTP_SECRET is the TOTP SEED (the base32 string Angel One
# shows you once when you enable 2FA / API access -- often as a QR
# code you'd normally scan into an authenticator app), NOT a live
# 6-digit OTP code you copy from your phone right now -- a live code
# expires in 30 seconds and would break on the very next login attempt.
# apps/market_data/broker_client.py generates the current code from
# this seed on every login (pyotp.TOTP(secret).now()), which is why it
# needs the seed, not a one-time code.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Symbols apps.signals/apps.market_data trade intraday. Comma-separated,
# no spaces. Every symbol here needs a real entry in
# apps/market_data/broker_client.py's SYMBOL_TOKENS (hardcoded map,
# NIFTY/BANKNIFTY only by default) -- adding a new symbol here without
# also adding its token there will raise ValueError the first time
# ingestion tries to fetch it, not silently do nothing.
WATCHLIST=NIFTY,BANKNIFTY

# Trailing stop-loss -- off by default. Set to 1 to let open positions'
# stops ratchet up as price makes new highs (see apps/execution/trailing_stop.py).
TRAILING_STOP_ENABLED=0
NEWSAPI_KEY=

# manual section 16: "Encrypt secrets" -- generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Not required for anything to run today (see common/crypto.py's
# docstring), but generate and set a real one before this platform
# ever stores a secret in a database field.
FIELD_ENCRYPTION_KEY=
