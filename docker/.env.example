# Copy this file to docker/.env and fill in real values. Never commit
# the real docker/.env (it is gitignored, same as backend/.env).
#
# These values must match backend/.env's own MYSQL_USER/MYSQL_PASSWORD/
# MYSQL_DATABASE/MYSQL_PORT -- docker-compose creates the MySQL user/
# database, Django's settings.py connects to it, and they will silently
# fail to agree if these two files drift.

MYSQL_DATABASE=algo_trading
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me-to-a-real-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-real-password
# Host-side port MySQL is published on (container side is always 3306).
# 3307 avoids clashing with a MySQL already running locally on the
# standard port -- must match backend/.env's own MYSQL_PORT.
MYSQL_HOST_PORT=3307
