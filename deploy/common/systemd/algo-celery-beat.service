[Unit]
Description=Algo Trading Platform - Celery Beat scheduler
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_ROOT__/backend
ExecStart=__REPO_ROOT__/backend/.venv/bin/celery -A config beat -l info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
