# Python / Django
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/migrations/__pycache__/
backend/.env
*.pyc
db.sqlite3

# Node / React
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editors / OS
.vscode/
.idea/
