# Python / Django
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/migrations/__pycache__/
backend/.env
*.pyc
db.sqlite3

# Node / React
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docker credentials -- see docker/.env.example
docker/.env

# Editors / OS
.vscode/
.idea/
.DS_Store

# Claude Code local settings (user/machine-specific, not project config)
.claude/

# Model artifacts -- these are large binary files that belong in
# object storage or a model registry backend, never in git
backend/artifacts/
backend/ml_artifacts/

# Runtime logs
backend/logs/
/*.log
/logs/

# Celery beat's local schedule DB (runtime state, like db.sqlite3)
backend/celerybeat-schedule*

# Electron desktop build output (frontend/electron/main.js + preload.js
# are source, kept; this is electron-builder's generated installer)
frontend/release/

# Capacitor Android -- the android/ project itself is checked in (it
# holds app-specific config: AndroidManifest.xml, res/, build.gradle
# customizations -- not regenerable from capacitor.config.json alone),
# but build outputs and machine-specific files are not:
frontend/android/local.properties
frontend/android/**/build/
frontend/android/.gradle/
frontend/android/captures/
frontend/android/app/src/main/assets/public/
*.apk
*.aab
